<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Bitbeans.Zpl.SkiaSharp</PackageId>
    <Description>SkiaSharp based image conversion for Bitbeans.Zpl (~DG and ~DY graphics, GRF to PNG) without ImageSharp.</Description>
    <PackageTags>zebra;zpl;zpl2;label;printer;skiasharp;image</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bitbeans.Zpl\Bitbeans.Zpl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bitbeans.Zpl.SkiaSharp.Tests" />
  </ItemGroup>

</Project>
